{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "toggl-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"ALLOWED_GITHUB_USERNAME": "huw",
		// Every OAuth token is bound to this URL. Set it to https://toggl-mcp.<subdomain>.workers.dev/mcp before deploying.
		"MCP_RESOURCE": "http://localhost:8788/mcp"
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "<Add-KV-ID>"
		}
	],
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8788
	},
	"secrets": {
		"required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "COOKIE_ENCRYPTION_KEY", "TOGGL_API_TOKEN"]
	}
}
